# ─────────────────────────────────────────────────────────────────────────────
# LUMO Backend — Environment Configuration EXAMPLE
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to git — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5001

# ─────────────────────────────────────────────────────────────
# JWT Secrets — Generate strong secrets for production:
#   openssl rand -hex 64
# ─────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET_64_CHARS
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5

# ─────────────────────────────────────────────────────────────
# PostgreSQL Database
# ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumo_db
DB_USER=lumo_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgres://lumo_user:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/lumo_db

# ─────────────────────────────────────────────────────────────
# Firebase Admin SDK
#
# RECOMMENDED (production): Base64-encode your service account JSON:
#   base64 -i firebase-service-account.json | tr -d '\n'
# Paste the result here:
# ─────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative: Individual fields (if you prefer not to base64-encode)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Local dev only (fallback — never use in production):
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─────────────────────────────────────────────────────────────
# Google Maps Platform API Key
# Obtain from: https://console.cloud.google.com/apis/credentials
# Or set via Admin Portal after first login.
# ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY

# ─────────────────────────────────────────────────────────────
# Razorpay Payment Gateway
# Obtain from: https://dashboard.razorpay.com/
# ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET

# ─────────────────────────────────────────────────────────────
# API Gateway Settings
# ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS.
# Add your production domain(s) here.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-admin-portal.com

# Microservice URLs (defaults work for local dev with docker-compose)
AUTH_SERVICE_URL=http://localhost:5001
USER_SERVICE_URL=http://localhost:5002
PRO_SERVICE_URL=http://localhost:5003
CATALOG_SERVICE_URL=http://localhost:5004
BOOKING_SERVICE_URL=http://localhost:5005
GEO_SERVICE_URL=http://localhost:5006
SAFETY_SERVICE_URL=http://localhost:5007
PAYMENT_SERVICE_URL=http://localhost:5008
NOTIFICATION_SERVICE_URL=http://localhost:5009
